{
  "manifest_version": 3,
  "name": "Job & Activity Tracker for Google Calendar",
  "version": "1.2.0",
  "description": "Track job applications, LeetCodes, and daily streaks with a direct visual overlay on Google Calendar.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Track Applications & LeetCode",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "commands": {
    "quick-add-job": {
      "suggested_key": {
        "default": "Alt+Shift+J",
        "mac": "Command+Shift+J"
      },
      "description": "Log +1 Job Application"
    },
    "quick-add-leetcode": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Log +1 LeetCode Problem"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://calendar.google.com/*"
      ],
      "js": [
        "shared/auth.js",
        "shared/storage.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://calendar.google.com/*",
    "https://www.googleapis.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
