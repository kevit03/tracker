{
  "manifest_version": 3,
  "name": "Job & Activity Tracker",
  "version": "1.0.0",
  "description": "Minimalistic tracker for job applications, LeetCodes, and daily stats connected to your calendar.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Track Applications",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
